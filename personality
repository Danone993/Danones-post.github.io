 EI:{left:"E · Экстраверсия",right:"I · Интроверсия",leftShort:"E",rightShort:"I",name:"Социальная энергия",explain:"насколько ответы склоняются к взаимодействию с людьми или к самостоятельному восстановлению сил"},
 SN:{left:"S · Конкретика",right:"N · Интуиция",leftShort:"S",rightShort:"N",name:"Информация и идеи",explain:"насколько ответы склоняются к наблюдаемым деталям и опыту или к закономерностям и возможностям"},
 TF:{left:"T · Логика",right:"F · Ценности",leftShort:"T",rightShort:"F",name:"Принятие решений",explain:"какой акцент чаще появляется в ответах: последовательность критериев или ценности и влияние на людей"},
 JP:{left:"J · Структура",right:"P · Гибкость",leftShort:"J",rightShort:"P",name:"Организация",explain:"насколько ответы склоняются к планированию и определённости или к спонтанности и открытым вариантам"}
};
const TYPE_NAMES={
 INTJ:"Стратег",INTP:"Аналитик",ENTJ:"Организатор",ENTP:"Исследователь",
 INFJ:"Советник",INFP:"Идеалист",ENFJ:"Наставник",ENFP:"Вдохновитель",
 ISTJ:"Практик",ISFJ:"Защитник",ESTJ:"Администратор",ESFJ:"Объединитель",
 ISTP:"Мастер",ISFP:"Создатель",ESTP:"Предприниматель",ESFP:"Энтузиаст"
};
const TYPE_BLURBS={
 INTJ:"В этом сочетании обычно заметны самостоятельность, интерес к идеям и стремление выстраивать долгосрочную картину. Это гипотеза о предпочтениях, а не готовое описание характера.",
 INTP:"Такое сочетание часто связывают с любознательностью, анализом и желанием понять, как устроены вещи. Практические привычки при этом могут сильно различаться.",
 ENTJ:"Этот типовой профиль обычно описывает инициативность, ориентацию на систему и готовность организовывать движение к цели. Он не означает, что человек всегда хочет руководить.",
 ENTP:"Профиль часто ассоциируют с исследованием возможностей, обсуждением идей и готовностью пересматривать подходы. Это не значит, что все решения принимаются импульсивно.",
 INFJ:"Такое сочетание часто связывают с поиском смысла, вниманием к людям и стремлением видеть общую картину. Реальные предпочтения могут меняться от ситуации к ситуации.",
 INFP:"Этот профиль обычно описывает внутренние ценности, воображение и интерес к личному смыслу. Он не говорит о том, насколько человек общителен или успешен.",
 ENFJ:"Профиль часто связывают с вниманием к группе, общению и стремлением помогать людям двигаться к общей цели. Это не обязанность быть лидером или постоянно заботиться о других.",
 ENFP:"Такое сочетание часто ассоциируют с любознательностью, интересом к людям и открытостью новым возможностям. Оно не означает, что человеку всегда легко общаться или завершать дела.",
 ISTJ:"Этот профиль часто описывает опору на факты, ответственность и предпочтение понятных договорённостей. Это не означает негибкость или отсутствие воображения.",
 ISFJ:"Такое сочетание обычно связывают с практической внимательностью, надёжностью и учётом потребностей людей. Оно не обязывает всегда ставить других на первое место.",
 ESTJ:"Профиль часто ассоциируют с организованностью, конкретными критериями и стремлением наладить процесс. Он не определяет стиль общения в каждой ситуации.",
 ESFJ:"Такое сочетание часто связывают с социальным участием, практичностью и вниманием к атмосфере в группе. Это не значит, что человек всегда соглашается с окружающими.",
 ISTP:"Профиль обычно описывает практический анализ, самостоятельность и гибкое решение задач по мере появления информации. Он не ограничивает интерес к теории или планированию.",
 ISFP:"Такое сочетание часто ассоциируют с личными ценностями, наблюдательностью и свободой выбора. Это не означает, что человек обязательно творческий в каком-то одном смысле.",
 ESTP:"Профиль часто описывает ориентацию на реальную ситуацию, быстрый отклик и практическое действие. Это не равнозначно безрассудности или любви к риску.",
 ESFP:"Такое сочетание обычно связывают с вовлечённостью в текущие события, людьми и непосредственным опытом. Оно не означает, что человек не умеет планировать или глубоко размышлять."
};
const answerLabels={1:"Совсем не согласен",2:"Скорее не согласен",3:"Зависит от ситуации / нейтрально",4:"Скорее согласен",5:"Полностью согласен"};
const $=id=>document.getElementById(id);
let order=[],answers={},index=0,resultsData=null,aiRequested=false;
function shuffle(arr){const out=[...arr];for(let i=out.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[out[i],out[j]]=[out[j],out[i]]}return out}
function show(el){el.classList.remove("hidden")}function hide(el){el.classList.add("hidden")}
function startTest(){order=shuffle(QUESTIONS);answers={};index=0;resultsData=null;aiRequested=false;hide($("intro"));hide($("howPanel"));hide($("results"));show($("quizPanel"));renderQuestion();window.scrollTo({top:0,behavior:"smooth"})}
function renderQuestion(){
 const q=order[index];$("progressLabel").textContent=`Вопрос ${index+1} из ${order.length}`;$("progressPct").textContent=`${Math.round((index+1)/order.length*100)}%`;$("progressFill").style.width=`${(index+1)/order.length*100}%`;$("progressBar").setAttribute("aria-valuenow",String(index+1));
 $("axisMeta").textContent=({EI:"Общение и восстановление сил",SN:"Факты, детали и возможности",TF:"Логика, ценности и решения",JP:"Планирование и гибкость"})[q.axis];
 $("questionText").textContent=q.text;const wrap=$("answerOptions");wrap.replaceChildren();
 for(let v=1;v<=5;v++){const label=document.createElement("label");label.className="answer"+(answers[q.id]===v?" selected":"");const input=document.createElement("input");input.type="radio";input.name="answer";input.value=String(v);input.checked=answers[q.id]===v;input.addEventListener("change",()=>{answers[q.id]=v;wrap.querySelectorAll(".answer").forEach(n=>n.classList.remove("selected"));label.classList.add("selected");hide($("answerError"))});const span=document.createElement("span");span.textContent=`${v} — ${answerLabels[v]}`;label.append(input,span);wrap.append(label)}
 $("backBtn").disabled=index===0;$("backBtn").style.opacity=index===0?".45":"1";$("nextBtn").textContent=index===order.length-1?"Посмотреть результат →":"Далее →";hide($("answerError"));
}
function nextQuestion(){const q=order[index];if(!answers[q.id]){show($("answerError"));return}if(index<order.length-1){index++;renderQuestion();window.scrollTo({top:0,behavior:"smooth"})}else calculateResults()}
function calculateResults(){
 const axisResults={};
 for(const axis of Object.keys(AXES)){const qs=QUESTIONS.filter(q=>q.axis===axis);let total=0;for(const q of qs){const v=answers[q.id];total+=q.pole===AXES[axis].rightShort?v:6-v}const avg=total/qs.length;axisResults[axis]={score:Math.round((avg-1)/4*100),avg:Number(avg.toFixed(2)),count:qs.length}}
 let type="";
 for(const axis of ["EI","SN","TF","JP"]){const d=axisResults[axis];type+=(d.score<50?AXES[axis].leftShort:AXES[axis].rightShort)}
 resultsData={type,axisResults,answers:{...answers}};
 renderResults();hide($("quizPanel"));show($("results"));window.scrollTo({top:0,behavior:"smooth"})
}
function renderResults(){
 const {type,axisResults}=resultsData;$("typeCode").textContent=type;$("typeName").textContent=TYPE_NAMES[type]||"Типовой профиль";$("typeIntro").textContent=TYPE_BLURBS[type]||"Результат показывает сочетание предпочтений по четырём шкалам.";
 const letters=$("typeLetters");letters.replaceChildren();for(let i=0;i<4;i++){const axis=["EI","SN","TF","JP"][i],d=axisResults[axis],side=d.score<50?AXES[axis].leftShort:AXES[axis].rightShort,chip=document.createElement("div");chip.className="type-chip";const b=document.createElement("b");b.textContent=type[i];const s=document.createElement("span");s.textContent=({EI:"Общение",SN:"Информация",TF:"Решения",JP:"Организация"})[axis];chip.append(b,s);letters.append(chip)}
 const list=$("axisResults");list.replaceChildren();for(const axis of ["EI","SN","TF","JP"]){const cfg=AXES[axis],d=axisResults[axis],leftScore=100-d.score,chosen=d.score<50?cfg.leftShort:cfg.rightShort,dist=Math.abs(d.score-50)*2;const item=document.createElement("div");const head=document.createElement("div");head.className="axis-head";const name=document.createElement("span");name.textContent=cfg.name;const value=document.createElement("small");value.textContent=`${chosen} · ${dist<16?"почти середина":dist<40?"умеренный уклон":"заметный уклон"}`;head.append(name,value);const scale=document.createElement("div");scale.className="axis-scale";scale.setAttribute("aria-label",`${cfg.leftShort} ${Math.round(leftScore)}%, ${cfg.rightShort} ${Math.round(d.score)}%`);const fill=document.createElement("div");fill.className="axis-fill";fill.style.width=`${d.score}%`;scale.append(fill);const labels=document.createElement("div");labels.className="axis-labels";const l=document.createElement("span");l.textContent=`${cfg.left} · ${Math.round(leftScore)}%`;const r=document.createElement("span");r.textContent=`${cfg.right} · ${Math.round(d.score)}%`;labels.append(l,r);const desc=document.createElement("div");desc.className="strength";desc.textContent=`${cfg.explain}. Это доля по внутренней шкале опросника, а не процент вероятности или научная норма.`;item.append(head,scale,labels,desc);list.append(item)}
 const close=Object.values(axisResults).some(d=>Math.abs(d.score-50)<12);$("interpretationNotice").textContent=close?"По одной или нескольким шкалам результат близок к середине. Поэтому буквенный тип может быть неустойчивым: похожие ответы в другой день могут изменить одну букву. Обрати особое внимание на сами шкалы, а не только на код.":"Буквенный код выбран по направлению каждой шкалы. Он упрощает результаты и не должен восприниматься как точная или неизменная категория.";
 $("aiReport").textContent="";hide($("aiReport"));hide($("aiError"));hide($("aiLoading"));$("aiBtn").disabled=false;$("aiBtn").textContent=AI_API_URL?"Создать подробный разбор":"ИИ-разбор не подключён — настрой URL API";$("aiBtn").disabled=!AI_API_URL; if(!AI_API_URL){$("aiPrivacy").textContent="Чтобы включить ИИ, сначала опубликуй серверный Worker и впиши его URL в переменную AI_API_URL в начале скрипта этой страницы. Пока доступен только автоматический результат по шкалам."}
}
async function requestAI(){
 if(!AI_API_URL||!resultsData||aiRequested)return;
 aiRequested=true;$("aiBtn").disabled=true;show($("aiLoading"));hide($("aiError"));hide($("aiReport"));
 const topAnswers=QUESTIONS.filter(q=>[1,2,4,5].includes(resultsData.answers[q.id])).map(q=>({question:q.text,answer:resultsData.answers[q.id],answerText:answerLabels[resultsData.answers[q.id]],axis:AXES[q.axis].name,pole:q.pole})).sort((a,b)=>Math.abs(b.answer-3)-Math.abs(a.answer-3)).slice(0,10);
 const payload={type:resultsData.type,axes:Object.fromEntries(Object.entries(resultsData.axisResults).map(([k,v])=>[k,{score:v.score,side:v.score<50?AXES[k].leftShort:AXES[k].rightShort}])),answers:topAnswers};
 try{
  const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),45000);
  const response=await fetch(AI_API_URL,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload),signal:controller.signal});clearTimeout(timeout);
  const data=await response.json().catch(()=>({}));
  if(!response.ok)throw new Error(data.error||`Сервер ответил с кодом ${response.status}.`);
  if(typeof data.report!=="string"||!data.report.trim())throw new Error("Сервер вернул пустой ответ.");
  $("aiReport").textContent=data.report.trim();show($("aiReport"));
 }catch(err){aiRequested=false;$("aiBtn").disabled=false;show($("aiError"));$("aiError").textContent=err.name==="AbortError"?"Запрос занял слишком много времени. Попробуй ещё раз.":`Не удалось получить ИИ-разбор: ${err.message||"ошибка соединения"}. Проверь URL API и настройки сервера.`}
 finally{hide($("aiLoading"))}
}
$("startBtn").addEventListener("click",startTest);$("howBtn").addEventListener("click",()=>{const p=$("howPanel");p.classList.toggle("hidden");if(!p.classList.contains("hidden"))p.scrollIntoView({behavior:"smooth",block:"nearest"})});
$("backBtn").addEventListener("click",()=>{if(index>0){index--;renderQuestion()}});$("nextBtn").addEventListener("click",nextQuestion);$("exitBtn").addEventListener("click",()=>{if(confirm("Выйти из теста? Текущий прогресс будет сброшен.")){hide($("quizPanel"));show($("intro"));window.scrollTo({top:0,behavior:"smooth"})}});
$("aiBtn").addEventListener("click",requestAI);$("restartBtn").addEventListener("click",()=>{hide($("results"));show($("intro"));window.scrollTo({top:0,behavior:"smooth"})});$("printBtn").addEventListener("click",()=>window.print());
$("themeToggle").addEventListener("click",()=>{document.body.classList.toggle("dark");$("themeToggle").textContent=document.body.classList.contains("dark")?"☀️":"🌙";try{localStorage.setItem("personality-theme",document.body.classList.contains("dark")?"dark":"light")}catch(e){}});
try{if(localStorage.getItem("personality-theme")==="dark"){document.body.classList.add("dark");$("themeToggle").textContent="☀️"}}catch(e){}
</script>
</body>
</html>
